# =============================================================================
# Orbit GKE Environment - Example Terraform Variables
# =============================================================================
# Copy this file to terraform.tfvars and customize for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Required Variables
# -----------------------------------------------------------------------------
project_id   = "your-gcp-project-id"
project_name = "orbit"
region       = "us-central1"

# -----------------------------------------------------------------------------
# VPC Configuration
# -----------------------------------------------------------------------------
vpc_subnet_cidr   = "10.0.0.0/20"
vpc_pods_cidr     = "10.16.0.0/14"
vpc_services_cidr = "10.20.0.0/20"

# -----------------------------------------------------------------------------
# GKE Cluster Configuration
# -----------------------------------------------------------------------------
regional_cluster        = true
enable_private_nodes    = true
enable_private_endpoint = false
master_ipv4_cidr_block  = "172.16.0.0/28"

# Allow access from your IP (replace with your actual IP or CIDR)
master_authorized_networks = [
  {
    cidr_block   = "0.0.0.0/0"
    display_name = "All networks (restrict in production)"
  }
]

kubernetes_version_prefix = "1.28."
release_channel           = "REGULAR"

node_pools = {
  default = {
    initial_node_count = 1
    min_node_count     = 1
    max_node_count     = 3
    machine_type       = "e2-medium"
    disk_size_gb       = 100
    disk_type          = "pd-standard"
    preemptible        = false
    spot               = false
  }
}

enable_network_policy = true

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
database_version                = "POSTGRES_15"
database_tier                   = "db-f1-micro"  # Use db-custom-2-4096 or larger for production
database_availability_type      = "ZONAL"         # Use REGIONAL for production
database_disk_size              = 20
database_name                   = "orbit"
database_user                   = "orbit"
# database_password             = null  # Leave null to auto-generate
database_backup_enabled         = true
database_point_in_time_recovery = true

# -----------------------------------------------------------------------------
# Kubernetes Addons
# -----------------------------------------------------------------------------
enable_nginx_ingress       = true
nginx_replica_count        = 2
enable_cert_manager        = true
create_letsencrypt_issuers = true
letsencrypt_email          = "admin@example.com"  # Required for Let's Encrypt

# -----------------------------------------------------------------------------
# ArgoCD Configuration
# -----------------------------------------------------------------------------
enable_argocd    = true
argocd_namespace = "argocd"

# -----------------------------------------------------------------------------
# External Secrets Configuration
# -----------------------------------------------------------------------------
enable_external_secrets          = true
external_secrets_namespace       = "external-secrets"
external_secrets_service_account = "external-secrets"
secret_refresh_interval          = "1h"

# -----------------------------------------------------------------------------
# GitOps Bootstrap Configuration
# -----------------------------------------------------------------------------
# Set to true to automatically deploy Orbit via ArgoCD with External Secrets
enable_gitops_bootstrap   = true
application_namespace     = "orbit"
deploy_argocd_application = true
enable_argocd_finalizer   = true

# -----------------------------------------------------------------------------
# Git Repository Configuration
# -----------------------------------------------------------------------------
# IMPORTANT: Update this to your forked/cloned repository URL
git_repo_url        = "https://github.com/YOUR_ORG/orbit.git"
git_target_revision = "main"
helm_chart_path     = "infrastructure/helm/orbit"
helm_value_files    = ["values.yaml", "values-production.yaml"]

# -----------------------------------------------------------------------------
# Container Images
# -----------------------------------------------------------------------------
# IMPORTANT: Update these to your container registry
backend_image_repository  = "ghcr.io/YOUR_ORG/orbit-backend"
backend_image_tag         = "latest"
frontend_image_repository = "ghcr.io/YOUR_ORG/orbit-frontend"
frontend_image_tag        = "latest"

# -----------------------------------------------------------------------------
# Application Ingress Configuration
# -----------------------------------------------------------------------------
enable_app_ingress = true
ingress_host       = "orbit.example.com"  # Your domain
enable_tls         = true
cluster_issuer     = "letsencrypt-prod"   # Use "letsencrypt-staging" for testing

# -----------------------------------------------------------------------------
# ArgoCD Sync Configuration
# -----------------------------------------------------------------------------
enable_auto_sync    = true
auto_sync_prune     = true
auto_sync_self_heal = true

# -----------------------------------------------------------------------------
# Labels & Protection
# -----------------------------------------------------------------------------
labels = {
  environment = "production"
  app         = "orbit"
  managed-by  = "terraform"
}

# Set to false to allow terraform destroy (NOT recommended for production)
deletion_protection = true
